---
import {
   Card,
   CardContent,
   CardDescription,
   CardFooter,
   CardHeader,
   CardTitle,
} from "@/components/ui/card";
import { Button } from "./ui/button";

interface Props {
   title: string;
   icon: "Facts" | "Projects";
   subTitle: string;
}

const { title, icon, subTitle } = Astro.props;
---

<Card>
   <CardContent>
      <CardHeader>
         {
            icon === "Projects" ? (
               <svg
                  width="4rem"
                  height="4rem"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="none"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="stroke-muted-foreground"
               >
                  <path
                     d="M11.8903 9.11013L6.52606 3.74585C6.13004 3.34983 5.93203 3.15182 5.7037 3.07763C5.50286 3.01237 5.28651 3.01237 5.08567 3.07763C4.85734 3.15182 4.65933 3.34983 4.26331 3.74584L3.69763 4.31153C3.30161 4.70755 3.1036 4.90555 3.02941 5.13388C2.96415 5.33473 2.96415 5.55107 3.02941 5.75192C3.1036 5.98024 3.30161 6.17826 3.69763 6.57427L9.06192 11.9386M14.7188 11.9386L20.0828 17.3026C20.4788 17.6986 20.6768 17.8966 20.751 18.125C20.8163 18.3258 20.8163 18.5422 20.751 18.743C20.6768 18.9713 20.4788 19.1693 20.0828 19.5654L19.5171 20.131C19.1211 20.5271 18.9231 20.7251 18.6948 20.7993C18.4939 20.8645 18.2776 20.8645 18.0767 20.7993C17.8484 20.7251 17.6504 20.5271 17.2544 20.131L11.8903 14.767M8.00024 6.99968L8.88946 6.10925M17.0002 15.9999L17.8945 15.1143M15.4998 5.50202L18.3282 8.33044M3 21.0018L3.04745 20.6696C3.21536 19.4942 3.29932 18.9066 3.49029 18.3579C3.65975 17.871 3.89124 17.408 4.17906 16.9803C4.50341 16.4984 4.92319 16.0786 5.76274 15.239L17.4107 3.59104C18.1918 2.80999 19.4581 2.80999 20.2392 3.59103C21.0202 4.37208 21.0202 5.63841 20.2392 6.41946L8.37744 18.2812C7.61579 19.0428 7.23497 19.4237 6.8012 19.7265C6.41618 19.9953 6.00093 20.218 5.56398 20.39C5.07171 20.5838 4.54375 20.6903 3.48793 20.9033L3 21.0018Z"
                     stroke="stroke-current"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                  />
               </svg>
            ) : (
               <svg
                  viewBox="0 0 24 24"
                  width="4rem"
                  height="4rem"
                  class="stroke-muted-foreground"
               >
                  <>
                     <g id="SVGRepo_bgCarrier" stroke-width="0" />
                     <g
                        id="SVGRepo_tracerCarrier"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                     />
                     <g id="SVGRepo_iconCarrier">
                        <title>bookmark_fill</title>{" "}
                        <g
                           id="页面-1"
                           stroke="none"
                           stroke-width="1"
                           fill="none"
                           fill-rule="evenodd"
                           style="--darkreader-inline-stroke: none;"
                           data-darkreader-inline-stroke=""
                        >
                           <g
                              id="Education"
                              transform="translate(-96.000000, -48.000000)"
                              fill-rule="nonzero"
                           >
                              <g
                                 id="bookmark_fill"
                                 transform="translate(96.000000, 48.000000)"
                              >
                                 <path
                                    d="M24,0 L24,24 L0,24 L0,0 L24,0 Z M12.5934901,23.257841 L12.5819402,23.2595131 L12.5108777,23.2950439 L12.4918791,23.2987469 L12.4918791,23.2987469 L12.4767152,23.2950439 L12.4056548,23.2595131 C12.3958229,23.2563662 12.3870493,23.2590235 12.3821421,23.2649074 L12.3780323,23.275831 L12.360941,23.7031097 L12.3658947,23.7234994 L12.3769048,23.7357139 L12.4804777,23.8096931 L12.4953491,23.8136134 L12.4953491,23.8136134 L12.5071152,23.8096931 L12.6106902,23.7357139 L12.6232938,23.7196733 L12.6232938,23.7196733 L12.6266527,23.7031097 L12.609561,23.275831 C12.6075724,23.2657013 12.6010112,23.2592993 12.5934901,23.257841 L12.5934901,23.257841 Z M12.8583906,23.1452862 L12.8445485,23.1473072 L12.6598443,23.2396597 L12.6498822,23.2499052 L12.6498822,23.2499052 L12.6471943,23.2611114 L12.6650943,23.6906389 L12.6699349,23.7034178 L12.6699349,23.7034178 L12.678386,23.7104931 L12.8793402,23.8032389 C12.8914285,23.8068999 12.9022333,23.8029875 12.9078286,23.7952264 L12.9118235,23.7811639 L12.8776777,23.1665331 C12.8752882,23.1545897 12.8674102,23.1470016 12.8583906,23.1452862 L12.8583906,23.1452862 Z M12.1430473,23.1473072 C12.1332178,23.1423925 12.1221763,23.1452606 12.1156365,23.1525954 L12.1099173,23.1665331 L12.0757714,23.7811639 C12.0751323,23.7926639 12.0828099,23.8018602 12.0926481,23.8045676 L12.108256,23.8032389 L12.3092106,23.7104931 L12.3186497,23.7024347 L12.3186497,23.7024347 L12.3225043,23.6906389 L12.340401,23.2611114 L12.337245,23.2485176 L12.337245,23.2485176 L12.3277531,23.2396597 L12.1430473,23.1473072 Z"
                                    id="MingCute"
                                    fill-rule="nonzero"
                                 />
                                 <path
                                    d="M4,5 C4,3.34315 5.34315,2 7,2 L17,2 C18.6569,2 20,3.34315 20,5 L20,21.0284 C20,22.2485 18.6209,22.9581 17.6281,22.249 L12,18.2289 L6.37186,22.249 C5.37906,22.9581 4,22.2485 4,21.0284 L4,5 Z"
                                    id="路径"
                                    fill="#c0bfbc"
                                    style="--darkreader-inline-fill: #071d3c;"
                                    data-darkreader-inline-fill=""
                                 />
                              </g>
                           </g>
                        </g>
                     </g>
                  </>
               </svg>
            )
         }
         <CardTitle>{title}</CardTitle>
         <CardDescription>{subTitle}</CardDescription>
      </CardHeader>
      <CardFooter>
         <Button variant={"secondary"} className="bg-muted">
            View {title}
         </Button>
      </CardFooter>
   </CardContent>
</Card>
